@model List<Entidades.ResumenCompra>

<!-- CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    /* Cabecera */
    table.dataTable thead {
        background-color: #6f42c1; /* Morado */
        color: white;
        border-radius: 1rem 1rem 0 0;
    }

    /* Filas pares e impares */
    table.dataTable tbody tr:nth-child(even) {
        background-color: #f0f0f5;
    }

    table.dataTable tbody tr:nth-child(odd) {
        background-color: #e0e0e7;
    }

    table.dataTable tbody tr:hover {
        background-color: #d6d6e0;
    }

    .dataTables_wrapper .dataTables_scroll {
        border-radius: 1rem;
        overflow: hidden;
    }

    table.dataTable {
        border-radius: 1rem;
        overflow: hidden;
        border: 2px solid #6f42c1;
    }

    div.dataTables_wrapper .dataTables_filter input,
    div.dataTables_wrapper .dataTables_length select {
        border: 1px solid #ccc;
        padding: 6px 10px;
        border-radius: 10px;
        margin-left: 8px;
    }

    .titulo-tabla {
        font-size: 1.6rem;
        font-weight: bold;
        color: #6f42c1;
        text-align: center;
        margin-bottom: 20px;
    }

    div.dataTables_wrapper .dataTables_paginate .paginate_button {
        background: #d6d6e0;
        border-radius: 10px;
        margin: 2px;
        padding: 0px 1px !important;
        color: #6f42c1 !important;
        border: none;
        transition: background-color 0.3s ease;
        font-size: 14px;
    }

        div.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background-color: #bca3e3 !important;
            color: white !important;
        }

        div.dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: #6f42c1 !important;
            color: white !important;
            font-weight: bold;
        }
</style>

<div class="container mt-4">
    <h2 class="titulo-tabla">Reservas del Usuario</h2>

    <table id="tablaReservas" class="table table-bordered display nowrap w-100">
        <thead>
            <tr>
                <th>Fecha Ida</th>
                <th>Fecha Vuelta</th>
                <th>Horario</th>
                <th>Clase</th>
                <th>Destino</th>
                <th>Total a Pagar</th>
                <th>Ver</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reserva in Model)
            {
                <tr>
                    <td>@reserva.FechaIda.ToString()</td>
                    <td>@reserva.FechaVuelta.ToString()</td>
                    <td>@reserva.Hora</td>
                    <td>@reserva.TipoViaje</td>
                    <td>@reserva.Destino</td>
                    <td class="text-end">@reserva.ValorTotalPagar.ToString()</td>
                    <td>
                        <button class="btn btn-outline-primary btn-sm ver-pasaje"
                                data-fechaida="@reserva.FechaIda.ToString()"
                                data-fechavuelta="@reserva.FechaVuelta.ToString()"
                                data-horario="@reserva.Hora"
                                data-clase="@reserva.TipoViaje"
                                data-destino="@reserva.Destino"
                                data-total="@reserva.ValorTotalPagar.ToString()">
                            👁 Ver
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Modal -->
    <div class="modal fade" id="modalPasaje" tabindex="-1" aria-labelledby="modalPasajeLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header bg-purple text-white rounded-top">
                    <h5 class="modal-title" id="modalPasajeLabel" style="color:black">Pasaje de Abordar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="border p-3 rounded" style="background-color: #f6f3fa;">
                        <p><strong>Destino:</strong> <span id="pasajeDestino"></span></p>
                        <p><strong>Fecha Ida:</strong> <span id="pasajeFechaIda"></span></p>
                        <p><strong>Fecha Vuelta:</strong> <span id="pasajeFechaVuelta"></span></p>
                        <p><strong>Horario:</strong> <span id="pasajeHorario"></span></p>
                        <p><strong>Clase:</strong> <span id="pasajeClase"></span></p>
                        <p><strong>Total:</strong> <span id="pasajeTotal"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JS Scripts al final para mejor rendimiento -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        const $tabla = $('#tablaReservas');

        if ($tabla.length) {
            if ($.fn.DataTable.isDataTable('#tablaReservas')) {
                $tabla.DataTable().destroy();
            }

            $tabla.DataTable({
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
                },
                scrollX: true
            });

            console.log("✅ DataTable cargado correctamente.");
        } else {
            console.warn("⚠️ No se encontró la tabla con id='tablaReservas'");
        }

        $(document).on('click', '.ver-pasaje', function () {
            $('#pasajeDestino').text($(this).data('destino'));
            $('#pasajeFechaIda').text($(this).data('fechaida'));
            $('#pasajeFechaVuelta').text($(this).data('fechavuelta'));
            $('#pasajeHorario').text($(this).data('horario'));
            $('#pasajeClase').text($(this).data('clase'));
            $('#pasajeTotal').text($(this).data('total'));

            $('#modalPasaje').modal('show');
        });
    });
</script>
