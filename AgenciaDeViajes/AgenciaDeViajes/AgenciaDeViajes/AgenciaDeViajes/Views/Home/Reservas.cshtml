@model Entidades.ReservasNuevas

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reservar Vuelo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jquery-ui-dist/jquery-ui.min.css">
    <style>
        body {
            background-image: url('https://source.unsplash.com/1600x900/?travel,airplane');
            background-size: cover;
            background-position: center;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 450px;
            margin-top: 50px;
        }

        .card {
            border-radius: 15px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .card-header {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
            padding: 15px;
        }

        .form-control, .form-select {
            border-radius: 8px;
        }

        .btn {
            border-radius: 8px;
            font-weight: bold;
        }

        .btn-primary {
            background: #007bff;
            border: none;
        }

        .btn-danger {
            background: #dc3545;
            border: none;
        }

            .btn-primary:hover, .btn-danger:hover {
                opacity: 0.85;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="card">
            <div class="card-header">
                ✈️ Reserva tu Vuelo
            </div>
            <div class="card-body">
                @using (Html.BeginForm("ReservarVuelo", "Home", FormMethod.Post))
                {

                    <div class="mb-3">
                        <label for="tipoViaje" class="form-label">Tipo de Viaje</label>
                        @Html.DropDownListFor(m => m.TipoViaje,
                         new SelectList(ViewBag.TipoViaje, "Via_id", "Via_nombre"),
                         "Seleccione un tipo",
                         new { @class = "form-control", required = "required" })
                    </div>

                    <div class="mb-3">
                        <label for="fechaVuelo" class="form-label">Fecha de Ida</label>
                        @Html.TextBoxFor(m => m.FechaVueloIda, new { @class = "form-control", id = "fechaVuelo", required = "required", placeholder = "Seleccione una fecha" })
                    </div>

                    <div class="mb-3" id="fechaRegresoDiv" style="display: none;">
                        <label for="fechaRegreso" class="form-label">Fecha de Regreso</label>
                        @Html.TextBoxFor(m => m.FechaVueloVuelta, new { @class = "form-control", id = "fechaVuelo", required = "required", placeholder = "Seleccione una fecha" })
                    </div>

                    <div class="mb-3">
                        <label for="clase" class="form-label">Clase de Vuelo</label>
                        @Html.DropDownListFor(m => m.Destino,
                        new SelectList(ViewBag.Destino, "Des_id", "Des_nombre"),
                        "Seleccione un tipo",
                        new { @class = "form-control", required = "required" })
                    </div>

                    <div class="mb-3">
                        <label for="horario" class="form-label">Horario Disponible</label>
                        @Html.DropDownListFor(m => m.Horario, new SelectList(new[]
                        {
                            "06:00 AM", "09:00 AM", "12:00 PM", "03:00 PM", "06:00 PM", "09:00 PM"
                        }), "Seleccione un horario", new { @class = "form-select", required = "required" })
                    </div>

                    <div class="mb-3">
                        <label for="clase" class="form-label">Clase de Vuelo</label>
                        @Html.DropDownListFor(m => m.Clase,
                        new SelectList(ViewBag.Clases, "CLas_Id", "Nombre"),
                        "Seleccione un tipo",
                        new { @class = "form-control", required = "required" })
                    </div>
                    @Html.Hidden("confirmacion", "1")
                    <button type="submit" class="btn btn-primary w-100">Reservar</button>
                }
                @if (TempData["MensajeExito"] != null)
                {
                    <div class="alert alert-success text-center mt-3">@TempData["MensajeExito"]</div>
                }

                <button id="cancelarReserva" class="btn btn-danger w-100 mt-3">Cancelar Reserva</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-ui-dist/jquery-ui.min.js"></script>
    <script>
        $(document).ready(function () {
            // Inicialización de datepicker
            $("#fechaVuelo, #fechaRegreso").datepicker({
                dateFormat: "yy-mm-dd",
                minDate: 0
            });

            $("#tipoViaje").change(function () {
                let tipoViaje = $(this).val();
                if (tipoViaje === "ida_vuelta") {
                    $("#fechaRegresoDiv").slideDown();
                    $("#fechaRegreso").prop("required", true);

                    $("#fechaVuelo").datepicker("option", "onSelect", function (selectedDate) {
                        let minRegreso = new Date(selectedDate);
                        minRegreso.setDate(minRegreso.getDate() + 1);
                        $("#fechaRegreso").datepicker("option", "minDate", minRegreso);
                    });

                } else {
                    $("#fechaRegresoDiv").slideUp();
                    $("#fechaRegreso").val("").prop("required", false);
                    $("#fechaVuelo").datepicker("option", "onSelect", null);
                }
            });

            $("#cancelarReserva").click(function () {
                if (confirm("¿Estás seguro de cancelar la reserva? Esto puede estar sujeto a cargos según la política de la agencia.")) {
                    alert("Reserva cancelada con éxito.");
                }
            });
        });
    </script>

</body>
</html>
