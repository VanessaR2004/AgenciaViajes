@model Entidades.UsuariosExistentes
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Viajes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <style>
        body {
            background-image: url('https://source.unsplash.com/1600x900/?travel');
            background-size: cover;
            background-position: center;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            background: rgba(255, 255, 255, 0.9);
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            width: 350px;
            text-align: center;
        }

            .login-container h2 {
                color: #007bff;
                margin-bottom: 20px;
            }

        .btn-custom {
            width: 100%;
            margin-top: 10px;
        }
        .alert-custom {
            background: rgba(255, 0, 0, 0.8); /* Rojo translúcido */
            color: white; /* Texto en blanco */
            font-weight: bold;
            border: 1px solid rgba(255, 0, 0, 0.9); /* Borde rojo más fuerte */
            border-radius: 8px;
            box-shadow: 0px 4px 15px rgba(255, 0, 0, 0.6); /* Sombra roja para efecto sobresalido */
            padding: 15px;
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1050; /* Asegura que esté sobre otros elementos */
            width: auto;
            max-width: 400px;
            text-align: center;
        }
            .alert-custom .btn-close {
                font-size: 12px; /* Reduce el tamaño del icono */
                width: 18px; /* Ajusta el ancho */
                height: 18px; /* Ajusta la altura */
                padding: 3px; /* Reduce el espacio interno */
                opacity: 0.8; /* Hace que no sea tan llamativo */
            }

    </style>
</head>
<body>
    <div class="login-container">
        <h2><i class="bi bi-airplane"></i> Bienvenido 🌍</h2>
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeExito"]
            </div>
        }
        @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
        {
            <div class="alert-custom alert @ViewBag.TipoMensaje alert-dismissible fade show" role="alert">
                <i class="bi @ViewBag.Icono"></i> @ViewBag.Mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @using (Html.BeginForm("Login", "Home", FormMethod.Post))
        {
            <div class="mb-3">
                <label class="form-label">Usuario:</label>
                @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", placeholder = "Ingrese su usuario" })
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña:</label>
                <div class="input-group">
                    @Html.TextBoxFor(m => m.Password, new { @class = "form-control", type = "password", placeholder = "Ingrese su contraseña", id = "passwordField" })

                </div>
            </div>

            <input type="hidden" id="bandera" name="bandera" value="">

            <button type="submit" class="btn btn-primary btn-custom" onclick="setBandera('login')">Ingresar</button>
            <button type="submit" class="btn btn-outline-secondary btn-custom" onclick="setBandera('recuperar')">Recuperar Contraseña</button>
            <button type="submit" class="btn btn-success btn-custom" onclick="setBandera('registrar')">Registrarse</button>
        }
    </div>

    <script>
        function setBandera(valor) {
            document.getElementById("bandera").value = valor;
        }

      
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
