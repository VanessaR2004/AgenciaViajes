@{
    string usuarioLogin = ViewBag.UsuarioLogin;
}
@model Entidades.CambiarContrasena
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .alert-custom {
            background: rgba(255, 0, 0, 0.8); /* Rojo translúcido */
            color: white; /* Texto en blanco */
            font-weight: bold;
            border: 1px solid rgba(255, 0, 0, 0.9); /* Borde rojo más fuerte */
            border-radius: 8px;
            box-shadow: 0px 4px 15px rgba(255, 0, 0, 0.6); /* Sombra roja para efecto sobresalido */
            padding: 15px;
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1050; /* Asegura que esté sobre otros elementos */
            width: auto;
            max-width: 400px;
            text-align: center;
        }

            .alert-custom .btn-close {
                font-size: 12px; /* Reduce el tamaño del icono */
                width: 18px; /* Ajusta el ancho */
                height: 18px; /* Ajusta la altura */
                padding: 3px; /* Reduce el espacio interno */
                opacity: 0.8; /* Hace que no sea tan llamativo */
            }
    </style>
</head>
<body class="bg-light">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-lg p-4 rounded">
                    @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
                    {
                        <div class="alert-custom alert @ViewBag.TipoMensaje alert-dismissible fade show" role="alert">
                            <i class="bi @ViewBag.Icono"></i> @ViewBag.Mensaje
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["MensajeExito"] != null)
                    {
                        <div class="alert alert-success text-center mt-3">@TempData["MensajeExito"]</div>
                    }
                    <h3 class="text-center mb-4">Cambiar Contraseña</h3>

                    <p class="text-center text-muted">
                        Cambio de contraseña para: <strong class="text-primary">@usuarioLogin</strong>
                    </p>

                    <input type="hidden" name="UsuarioId" value="@usuarioLogin" /> <!-- ID oculto -->

                    @using (Html.BeginForm("CambiarContrasena", "Home", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        <div class="mb-3">
                            <label for="nuevaContrasena" class="form-label">Nueva Contraseña</label>
                            @Html.PasswordFor(m => m.PasswordNuevo, new { @class = "form-control", required = "required", placeholder = "Ingrese nueva contraseña" })
                        </div>

                        <div class="mb-3">
                            <label for="confirmarContrasena" class="form-label">Confirmar Contraseña</label>
                            @Html.PasswordFor(m => m.PasswordConfirmar, new { @class = "form-control", required = "required", placeholder = "Confirme la nueva contraseña" })
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Guardar Contraseña</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 Script (Opcional si ya lo tienes en tu layout) -->
    <script>
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
